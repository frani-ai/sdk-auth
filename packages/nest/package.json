{
  "name": "@frani-ai/auth-nest",
  "version": "0.2.0",
  "description": "NestJS guards e decorators para validar JWT Bifrost e autorizar rotas (permissions + roles)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frani-ai/sdk-auth.git",
    "directory": "packages/nest"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.13"
  },
  "dependencies": {
    "@frani-ai/auth-sdk": "0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
