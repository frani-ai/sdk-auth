{
  "name": "@frani-ai/auth-next",
  "version": "0.1.0",
  "description": "Route handlers e helpers Next.js para Frani Auth SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frani-ai/sdk-auth.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@frani-ai/auth-sdk": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
